<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <!-- Only packaged development/PC LAN hosts; public backends require HTTPS. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.3.2</domain>
        <domain includeSubdomains="false">192.168.2.36</domain>
        <domain includeSubdomains="false">192.168.137.1</domain>
        <domain includeSubdomains="false">172.30.250.103</domain>
    </domain-config>
</network-security-config>
