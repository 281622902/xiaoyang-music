"create or replace function public.set_security_question(p_question text, p_answer_hash text) returns boolean language sql security definer set search_path = public as $$ insert into public.account_security (user_id, phone, question, answer_hash, attempts, locked_until) values (auth.uid(), right(coalesce((select phone from auth.users where id = auth.uid()), ''), 11), left(p_question, 100), left(p_answer_hash, 64), 0, null) on conflict (user_id) do update set question = excluded.question, answer_hash = excluded.answer_hash, attempts = 0, locked_until = null, updated_at = now() returning true; $$; revoke all on function public.set_security_question(text, text) from public, anon; grant execute on function public.set_security_question(text, text) to authenticated;"